// ============================================
// ROADMAP FEATURE MODELS
// ============================================

model Roadmap {
  id           String        @id @default(uuid())
  mentorshipId String
  title        String
  description  String?
  duration     Int // Duration in weeks (4, 8, or 12)
  focusArea    String // Main focus area/goal
  status       RoadmapStatus @default(ACTIVE)
  startDate    DateTime      @default(now())
  endDate      DateTime // Calculated based on duration
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  isTemplate   Boolean       @default(false) // True if this is a template
  templateName String? // Name if saved as template
  mentorship   Mentorship    @relation(fields: [mentorshipId], references: [id])
  milestones   Milestone[]

  @@index([mentorshipId])
  @@index([status])
  @@index([isTemplate])
  @@index([startDate])
}

model Milestone {
  id          String            @id @default(uuid())
  roadmapId   String
  title       String
  description String?
  order       Int // Sequence order in roadmap
  dueDate     DateTime
  status      MilestoneStatus   @default(NOT_STARTED)
  completedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  roadmap     Roadmap           @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  tasks       Task[]
  checkIns    CheckIn[]
  resources   RoadmapResource[]

  @@index([roadmapId])
  @@index([status])
  @@index([dueDate])
  @@index([roadmapId, order])
}

model CheckIn {
  id            String        @id @default(uuid())
  milestoneId   String
  sessionId     String?       @unique // Optional link to Session
  mentorNotes   String?
  menteeNotes   String?
  scheduledDate DateTime
  completedDate DateTime?
  status        CheckInStatus @default(SCHEDULED)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  milestone     Milestone     @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  session       Session?      @relation("CheckInSession", fields: [sessionId], references: [id])

  @@index([milestoneId])
  @@index([status])
  @@index([scheduledDate])
}

model RoadmapResource {
  id           String       @id @default(uuid())
  milestoneId  String
  title        String
  url          String
  description  String?
  resourceType ResourceType @default(LINK)
  createdAt    DateTime     @default(now())
  milestone    Milestone    @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  @@index([milestoneId])
}

enum RoadmapStatus {
  ACTIVE
  COMPLETED
  PAUSED
  ARCHIVED
}

enum MilestoneStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum CheckInStatus {
  SCHEDULED
  COMPLETED
  MISSED
  CANCELLED
}

enum ResourceType {
  LINK
  VIDEO
  ARTICLE
  DOCUMENT
  OTHER
}
